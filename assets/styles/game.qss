/* ══════════════════════════════════════════════════════
   Fireboy & Watergirl – Forest Temple  (QSS Stylesheet)
   ══════════════════════════════════════════════════════ */

/* ── Global ─────────────────────────────────────────── */
QWidget {
    background-color: #0a0a14;
    color: #e8e8f0;
    font-family: "Segoe UI", "Ubuntu", "Arial", sans-serif;
    font-size: 13px;
}

QMainWindow {
    background-color: #0a0a14;
}

/* ── Menu Page ──────────────────────────────────────── */
QWidget#menuPage, QWidget#lbPage, QWidget#namePage {
    background-image: url('assets/images/bg_ruins.png');
    background-position: center;
}

/* ── Title Labels ───────────────────────────────────── */
QLabel#titleLabel {
    font-size: 38px;
    font-weight: 900;
    color: #ffcc00;
    padding: 8px 0px;
}

QLabel#subLabel {
    font-size: 16px;
    color: #8899aa;
    letter-spacing: 3px;
    font-weight: 600;
}

QLabel#controlsLabel {
    font-size: 12px;
    color: #6677aa;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 10px;
    padding: 14px 20px;
    line-height: 1.8;
}

/* ── Primary Play Button ─────────────────────────────── */
QPushButton#btnPlay, QPushButton#btnSubmit {
    background: rgba(220, 110, 40, 0.15);
    color: #ffd0a0;
    border: 2px solid rgba(220, 110, 40, 0.4);
    border-radius: 12px;
    font-size: 14px;
    font-weight: 700;
    padding: 8px 24px;
}
QPushButton#btnPlay:hover, QPushButton#btnSubmit:hover {
    background: rgba(220, 110, 40, 0.28);
    border-color: rgba(255, 150, 60, 0.7);
    color: #ffeedd;
}
QPushButton#btnPlay:pressed, QPushButton#btnSubmit:pressed {
    background: rgba(180, 80, 20, 0.35);
}

/* ── Secondary Buttons ───────────────────────────────── */
QPushButton#btnSecondary {
    background: rgba(60, 120, 200, 0.15);
    color: #80c0ff;
    border: 2px solid rgba(60, 120, 200, 0.4);
    border-radius: 12px;
    font-size: 14px;
    font-weight: 700;
    padding: 8px 24px;
}
QPushButton#btnSecondary:hover {
    background: rgba(60, 120, 200, 0.28);
    border-color: rgba(60, 150, 255, 0.7);
    color: #b0d8ff;
}
QPushButton#btnSecondary:pressed {
    background: rgba(40, 90, 160, 0.35);
}

/* ── Quit Button ─────────────────────────────────────── */
QPushButton#btnQuit {
    background: rgba(180, 30, 30, 0.12);
    color: #ff7070;
    border: 2px solid rgba(180, 30, 30, 0.3);
    border-radius: 12px;
    font-size: 14px;
    font-weight: 700;
    padding: 8px 24px;
}
QPushButton#btnQuit:hover {
    background: rgba(200, 40, 40, 0.25);
    border-color: rgba(220, 60, 60, 0.6);
    color: #ffaaaa;
}

/* ── Leaderboard Table ───────────────────────────────── */
QTableWidget#lbTable {
    background-color: rgba(255,255,255,0.03);
    alternate-background-color: rgba(255,255,255,0.055);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 10px;
    gridline-color: rgba(255,255,255,0.06);
    color: #d0d8f0;
    font-size: 13px;
    selection-background-color: rgba(80,160,255,0.25);
    selection-color: #ffffff;
}
QHeaderView::section {
    background-color: rgba(40,60,100,0.5);
    color: #80b0ff;
    font-weight: 700;
    font-size: 12px;
    border: none;
    border-bottom: 2px solid rgba(80,130,220,0.4);
    padding: 8px;
    letter-spacing: 1px;
}
QTableWidget#lbTable::item {
    padding: 6px 10px;
}
QScrollBar:vertical {
    background: rgba(255,255,255,0.04);
    width: 8px;
    border-radius: 4px;
}
QScrollBar::handle:vertical {
    background: rgba(255,255,255,0.2);
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

/* ── Input Dialog ─────────────────────────────────────── */
QInputDialog {
    background: #141424;
}
QInputDialog QLineEdit {
    background: rgba(255,255,255,0.07);
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 8px;
    color: #e0e8ff;
    padding: 6px 10px;
    font-size: 14px;
}
QInputDialog QLineEdit:focus {
    border-color: rgba(80,150,255,0.7);
}
QInputDialog QPushButton {
    background: rgba(80,130,200,0.3);
    color: #a0c8ff;
    border: 1px solid rgba(80,130,200,0.5);
    border-radius: 8px;
    padding: 5px 18px;
    font-weight: 700;
}
QInputDialog QPushButton:hover {
    background: rgba(80,150,230,0.45);
}

/* ── Name Entry Page ─────────────────────────────────── */QLineEdit#nameInput {
    background: rgba(255,255,255,0.05);
    border: 2px solid rgba(255,255,255,0.1);
    border-radius: 12px;
    color: #ffffff;
    padding: 10px 20px;
    font-size: 20px;
    font-weight: bold;
    selection-background-color: rgba(255,96,32,0.5);
}
QLineEdit#nameInput:focus {
    border-color: #ff6020;
    background: rgba(255,255,255,0.08);
}
